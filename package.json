{
  "name": "hookflow-platform",
  "private": true,
  "description": "Webhook delivery and event management platform: signed deliveries, retries with backoff, dead-lettering, replay and live delivery logs.",
  "workspaces": [
    "apps/api",
    "apps/dashboard",
    "apps/receiver"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "db:migrate": "npm run db:migrate -w apps/api",
    "dev:api": "npm run start:dev -w apps/api",
    "dev:worker": "npm run start:worker:dev -w apps/api",
    "dev:dashboard": "npm run dev -w apps/dashboard",
    "dev:receiver": "npm run start -w apps/receiver",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm test -w @hookflow/api && npm test -w @hookflow/receiver",
    "test:e2e": "npm run test:e2e -w apps/api",
    "demo": "node scripts/demo.mjs"
  }
}
