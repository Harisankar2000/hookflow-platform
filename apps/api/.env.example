PORT=3200
DATABASE_URL=postgresql://hookflow:hookflow@localhost:5440/hookflow
REDIS_URL=redis://localhost:6390
# Required to create organizations through POST /v1/organizations
ADMIN_TOKEN=change-me-admin-token
CORS_ORIGIN=http://localhost:5180
# Delivery tuning
DELIVERY_TIMEOUT_MS=10000
DELIVERY_CONCURRENCY=10
# Comma-separated delays (ms) before each retry; length + 1 = max attempts
RETRY_SCHEDULE_MS=5000,30000,120000,600000,1800000
# Run the delivery worker inside the API process (handy for local dev)
RUN_WORKER_IN_API=true
LOG_LEVEL=info
